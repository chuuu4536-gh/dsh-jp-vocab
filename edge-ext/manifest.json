{
  "manifest_version": 3,
  "name": "日语查词 · 星标收藏",
  "version": "1.1.1",
  "description": "选中日文单词即可查词，一键星标收藏到每日词汇表。",
  "key": "",
  "permissions": ["storage", "nativeMessaging"],
  "host_permissions": ["https://dict.asia/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "日语查词设置"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
